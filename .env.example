# Copy to .env to override docker compose defaults.

# Average generated events per second over a simulated day.
GEN_EVENTS_PER_SECOND=50
# Simulated clock speed (12 = one simulated day per two real hours).
GEN_TIME_SCALE=12
# Inject anomalies (cancellation spike, revenue drop, bad producer) every ~7 minutes.
GEN_ANOMALIES=true
